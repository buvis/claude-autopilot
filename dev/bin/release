#!/usr/bin/env bash
# Thin shim: the shared release logic lives in the claude-plugins repo, next
# to the central marketplace.json it stamps. Repo-specific steps hook in via
# dev/bin/release-checks (pre-bump) and dev/bin/release-build (post-bump).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
CENTRAL_REPO="$REPO_ROOT/../claude-plugins"
RELEASE="$CENTRAL_REPO/scripts/release-plugin"

BLOCKED="$(grep -rli "release is blocked" "$REPO_ROOT/docs/dev/project-management/prds/hold" "$REPO_ROOT/docs/dev/project-management/prds/wip" 2>/dev/null || true)"
if [ -n "$BLOCKED" ]; then
  echo "Error: release blocked by:" >&2
  echo "$BLOCKED" >&2
  exit 1
fi

if [ ! -x "$RELEASE" ]; then
  echo "Error: $RELEASE not found - clone buvis/claude-plugins beside this repo" >&2
  exit 1
fi

echo "[release] pulling latest claude-plugins (shared script + marketplace)"
git -C "$CENTRAL_REPO" pull --ff-only

cd "$REPO_ROOT"
exec "$RELEASE" "$@"
