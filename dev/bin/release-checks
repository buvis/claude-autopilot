#!/usr/bin/env bash
# Pre-release checks for autopilot. Run by claude-plugins/scripts/release-plugin
# with CWD = repo root.
#
# The gate is the pack's own test suites. They pin the reviewer registry
# (no lane can write to the repo it reviews, every persona dispatches),
# the runner recursion guard, and the state schema the loop depends on.
# Shipping past a red suite would ship a pipeline whose promises are untrue.
#
# Prints one `PASS n FAIL n SKIP n EXIT c` summary line at the end so
# cli/verification.py's run_gate() can read block counts without a second
# run (SUMMARY_RE in skills/run-autopilot/cli/verification.py). Each
# `run_pytest`/`run_harness`/`run_gather_harness` call below reports its
# own real counts via a count adapter (pytest's own -q summary line for
# pytest blocks, PASS: line counts for the two gather-context harnesses, a
# pass/fail count for the remaining shell harnesses) and a failing call no
# longer aborts the script -- `set -e` is gone, so FAIL reflects real
# failures instead of always reading 0. A call that cannot report at all
# (aborts before any count) is never folded into FAIL as an invented
# number; it only forces EXIT non-zero. The `echo "[checks] <name>"`
# lines are unchanged from before this rewrite -- several existing tests
# (test_release_checks_parallel_prose.py, test_wave_docs.py,
# test_triage_prose.py, test_enter_prose.py, test_design_rework_prose.py,
# test_custody_prose.py) parse this file by scanning for those exact
# lines and the block of commands between one and the next; the helpers
# below never print their own "[checks]" line, so that scan is undisturbed.
set -uo pipefail

TOTAL_PASS=0
TOTAL_FAIL=0
TOTAL_SKIP=0
INFRA_FAIL=0
# The only skips this gate tolerates: two AUTOPILOT_LIVE-gated tests.
SKIP_ALLOWED=2

# Runs a pytest invocation, parses its own -q summary line for real counts.
# Prints no block header -- the caller's own "echo [checks] ..." line is
# the header.
run_pytest() {
  local out rc
  out="$("$@" -rs 2>&1)"
  rc=$?
  echo "$out"
  local p f s
  p="$(echo "$out" | grep -oE '[0-9]+ passed' | tail -1 | grep -oE '[0-9]+')"
  f="$(echo "$out" | grep -oE '[0-9]+ failed' | tail -1 | grep -oE '[0-9]+')"
  s="$(echo "$out" | grep -oE '[0-9]+ skipped' | tail -1 | grep -oE '[0-9]+')"
  if [[ -z "$p" && -z "$f" && -z "$s" ]]; then
    echo "release-checks: no parseable pytest summary -- infrastructure failure"
    INFRA_FAIL=1
    return
  fi
  TOTAL_PASS=$((TOTAL_PASS + ${p:-0}))
  TOTAL_FAIL=$((TOTAL_FAIL + ${f:-0}))
  TOTAL_SKIP=$((TOTAL_SKIP + ${s:-0}))
  if [[ "$TOTAL_SKIP" -gt "$SKIP_ALLOWED" ]]; then
    echo "release-checks: SKIP $TOTAL_SKIP exceeds the ceiling of $SKIP_ALLOWED"
    INFRA_FAIL=1
  fi
  # A non-zero exit with no counted failure (collection errors) is not green.
  if [[ "$rc" -ne 0 && "${f:-0}" -eq 0 ]]; then
    INFRA_FAIL=1
  fi
}

# Runs a shell-harness script. Its own final "SUMMARY: N passed, M failed"
# line supplies the counts; without one, one pass/fail case by exit code.
# Any "SKIP: <reason>" line the harness prints counts toward TOTAL_SKIP the
# same way a pytest skip does, so a harness skip reaches the gate's ceiling
# instead of vanishing.
run_harness() {
  local out rc
  out="$("$@" 2>&1)"
  rc=$?
  echo "$out"
  local line p f sk
  line="$(echo "$out" | grep -E '^SUMMARY: [0-9]+ passed, [0-9]+ failed' | tail -1 || true)"
  if [[ -n "$line" ]]; then
    p="$(echo "$line" | sed -E 's/^SUMMARY: ([0-9]+) passed, ([0-9]+) failed.*/\1/')"
    f="$(echo "$line" | sed -E 's/^SUMMARY: ([0-9]+) passed, ([0-9]+) failed.*/\2/')"
    TOTAL_PASS=$((TOTAL_PASS + p))
    TOTAL_FAIL=$((TOTAL_FAIL + f))
    if [[ "$rc" -ne 0 && "$f" -eq 0 ]]; then
      INFRA_FAIL=1
    fi
  elif [[ "$rc" -eq 0 ]]; then
    TOTAL_PASS=$((TOTAL_PASS + 1))
  else
    TOTAL_FAIL=$((TOTAL_FAIL + 1))
  fi
  sk="$(echo "$out" | grep -c '^SKIP:' || true)"
  TOTAL_SKIP=$((TOTAL_SKIP + sk))
  if [[ "$TOTAL_SKIP" -gt "$SKIP_ALLOWED" ]]; then
    echo "release-checks: SKIP $TOTAL_SKIP exceeds the ceiling of $SKIP_ALLOWED"
    INFRA_FAIL=1
  fi
}

# Runs a gather-context harness: counts its own "PASS:" lines as passed
# cases. A fail-fast abort before any PASS: line is an infrastructure
# failure (unknown remainder), not a measured failed count.
run_gather_harness() {
  local out rc
  out="$("$@" 2>&1)"
  rc=$?
  echo "$out"
  local p
  p="$(echo "$out" | grep -c '^PASS:' || true)"
  if [[ "$rc" -ne 0 && "$p" -eq 0 ]]; then
    echo "release-checks: aborted before any PASS: line -- infrastructure failure"
    INFRA_FAIL=1
    return
  fi
  TOTAL_PASS=$((TOTAL_PASS + p))
  if [[ "$rc" -ne 0 ]]; then
    INFRA_FAIL=1
  fi
}

