#!/usr/bin/env bash
# Pre-release checks for autopilot. Run by claude-plugins/scripts/release-plugin
# with CWD = repo root.
#
# The gate is the pack's own test suites. They pin the reviewer registry
# (no lane can write to the repo it reviews, every persona dispatches),
# the runner recursion guard, and the state schema the loop depends on.
# Shipping past a red suite would ship a pipeline whose promises are untrue.
set -euo pipefail

echo "[checks] reviewer registry"
uv run --no-project --with pytest python -m pytest -q \
  skills/review-work-completion/scripts/test_agent_registry.py \
  skills/review-work-completion/scripts/test_carl_skip_prose.py \
  skills/review-work-completion/scripts/test_reviewer_dispatch_prose.py

echo "[checks] retry policy prose"
uv run --no-project --with pytest python -m pytest -q \
  skills/review-work-completion/scripts/test_retry_policy_prose.py

echo "[checks] adversarial cap prose"
uv run --no-project --with pytest python -m pytest -q \
  skills/work/scripts/test_adversarial_cap_prose.py \
  skills/work/scripts/test_devon_round_prose.py

echo "[checks] narrow runs prose"
uv run --no-project --with pytest python -m pytest -q \
  skills/work/scripts/test_narrow_runs_prose.py

echo "[checks] record_dispatch"
uv run --no-project --with pytest python -m pytest -q \
  skills/work/scripts/test_record_dispatch.py

echo "[checks] hook registration"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/scripts/test_review_coverage_hook_registration.py \
  hooks/test_hook_registration.py \
  hooks/test_enforce_prd_location.py \
  hooks/test_guard_skill_after_leave.py \
  hooks/test_guard_stop_on_live_lanes.py

echo "[checks] custody push guard"
uv run --no-project --with pytest python -m pytest -q hooks/test_guard_push_on_critical.py
uv run --no-project --with pytest python -m pytest -q hooks/test_guard_push_grammar.py

# capped at 4 workers: bare -n auto resolves to 18 workers on this host and
# dies with fork/process-table exhaustion (Errno 35/12, SIGKILLed git
# children) on these blocks (PRD 00233)
echo "[checks] custody core"
uv run --no-project --with pytest --with pytest-xdist python -m pytest -q -n auto --maxprocesses 4 \
  skills/run-autopilot/cli/test_custody.py \
  skills/run-autopilot/cli/test_custody_stall.py \
  skills/run-autopilot/cli/test_custody_resolve.py \
  skills/run-autopilot/cli/test_custody_loud.py \
  skills/run-autopilot/cli/test_custody_entry.py \
  skills/run-autopilot/cli/test_custody_prose.py \
  skills/run-autopilot/cli/test_custody_prose_schema.py \
  skills/run-autopilot/cli/test_render_custody.py

echo "[checks] runner recursion guard"
bash skills/use-codex/scripts/test_codex_run.sh
bash skills/use-codex/scripts/test_codex_run_resume.sh
bash skills/use-gemini/scripts/test_gemini_run.sh
bash skills/use-sonnet/scripts/test_sonnet_run.sh

echo "[checks] fast-track lane"
uv run --no-project --with pytest python -m pytest -q skills/fast-track/scripts

# serial: mixes files outside skills/run-autopilot/cli/, not covered by the
# whole-cli-directory parallel-safety proof (PRD 00233)
echo "[checks] plan size gate"
uv run --no-project --with pytest python -m pytest -q \
  skills/plan-tasks/scripts/test_plan_size_gate_prose.py \
  skills/run-autopilot/cli/test_policy.py \
  skills/run-autopilot/cli/test_policy_budget.py \
  skills/run-autopilot/cli/test_rework_groups.py

echo "[checks] l3"
uv run --no-project --with pytest --with pytest-xdist python -m pytest -q -n auto --maxprocesses 4 \
  skills/run-autopilot/cli/test_loop_prose.py \
  skills/run-autopilot/cli/test_pause.py \
  skills/run-autopilot/cli/test_usage_limit.py \
  skills/run-autopilot/cli/test_loop_decision.py \
  skills/run-autopilot/cli/test_brief.py \
  skills/run-autopilot/cli/test_runner.py \
  skills/run-autopilot/cli/test_watchdog.py \
  skills/run-autopilot/cli/test_handoff_request.py

echo "[checks] reporting"
uv run --no-project --with pytest --with pytest-xdist python -m pytest -q -n auto --maxprocesses 4 \
  skills/run-autopilot/cli/test_loop_metrics.py \
  skills/run-autopilot/cli/test_render_report.py \
  skills/run-autopilot/cli/test_render.py \
  skills/run-autopilot/cli/test_routing.py

# serial: no skills/run-autopilot/cli/ files here, outside PRD 00233's scope
echo "[checks] cap hook"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/scripts/test_autopilot_context_cap_hook.py \
  skills/run-autopilot/scripts/test_autopilot_cap_headroom.py \
  skills/run-autopilot/scripts/test_autopilot_cap_headroom_margin.py \
  skills/run-autopilot/scripts/test_autopilot_cap_breach.py \
  skills/run-autopilot/scripts/test_autopilot_cap_rotation.py \
  skills/run-autopilot/scripts/test_autopilot_cap_review_phase.py \
  skills/run-autopilot/scripts/test_cap_headroom_module.py \
  skills/run-autopilot/scripts/test_review_resume_prose.py \
  skills/run-autopilot/scripts/test_rework_tier_prose.py \
  skills/work/scripts/test_handoff_placement_prose.py \
  skills/run-autopilot/scripts/test_rework_groups_prose.py

# serial: mixes files outside skills/run-autopilot/cli/, not covered by the
# whole-cli-directory parallel-safety proof (PRD 00233)
echo "[checks] design rework prose"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/scripts/test_design_review_contract.py \
  skills/run-autopilot/cli/test_design_rework_prose.py
# serial: no skills/run-autopilot/cli/ files here, outside PRD 00233's scope
echo "[checks] loop blockers prose"
uv run --no-project --with pytest python -m pytest -q \
  skills/work/scripts/test_tess_size_limits_prose.py \
  skills/work/scripts/test_step_order_prose.py \
  skills/work/scripts/test_loop_blockers_prose.py

# serial: mixes files outside skills/run-autopilot/cli/, not covered by the
# whole-cli-directory parallel-safety proof (PRD 00233)
echo "[checks] l4"
uv run --no-project --with pytest python -m pytest -q \
  skills/review-work-completion/scripts/test_consolidate_findings.py \
  skills/review-work-completion/scripts/test_citation_format_prose.py \
  skills/run-autopilot/cli/test_triage.py \
  skills/run-autopilot/cli/test_triage_prose.py
# serial: mixes files outside skills/run-autopilot/cli/, not covered by the
# whole-cli-directory parallel-safety proof (PRD 00233)
echo "[checks] effort lanes"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_lane.py \
  skills/run-autopilot/cli/test_lane_cli.py \
  skills/run-autopilot/scripts/test_lane_prose.py \
  skills/run-autopilot/cli/test_release_checks_parallel_prose.py

# serial: spawns its own -n 2 subprocess internally (PRD 00233)
echo "[checks] parallel safety"
uv run --no-project --with pytest --with pytest-xdist python -m pytest -q \
  skills/run-autopilot/cli/test_parallel_safety.py

echo "[checks] waves"
uv run --no-project --with pytest --with pytest-xdist python -m pytest -q -n auto --maxprocesses 4 \
  skills/run-autopilot/cli/test_wave.py \
  skills/run-autopilot/cli/test_wave_launch.py \
  skills/run-autopilot/cli/test_wave_launch_status.py \
  skills/run-autopilot/cli/test_wave_launch_abort.py \
  skills/run-autopilot/cli/test_wave_launch_abort_keep.py \
  skills/run-autopilot/cli/test_wave_launch_abort_kill.py \
  skills/run-autopilot/cli/test_wave_launch_refusals.py \
  skills/run-autopilot/cli/test_wave_assemble.py \
  skills/run-autopilot/cli/test_wave_assemble_migrate.py \
  skills/run-autopilot/cli/test_wave_assemble_summary.py \
  skills/run-autopilot/cli/test_wave_cli_assemble.py \
  skills/run-autopilot/cli/test_wave_cli_refusals.py \
  skills/run-autopilot/cli/test_wave_docs.py \
  skills/run-autopilot/cli/test_wave_run.py \
  skills/run-autopilot/cli/test_wave_review.py \
  skills/run-autopilot/cli/test_wave_review_land.py \
  skills/run-autopilot/cli/test_wave_slots.py \
  skills/run-autopilot/cli/test_loop_slots.py

echo "[checks] store tree"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_store_tree_foreign_dirty.py \
  skills/run-autopilot/cli/test_store_tree_record_store.py \
  skills/run-autopilot/cli/test_store_tree_cli.py \
  skills/run-autopilot/cli/test_store_tree_custody.py \
  skills/run-autopilot/cli/test_store_tree_gitignore.py \
  skills/run-autopilot/cli/test_store_gitignore.py \
  skills/run-autopilot/cli/test_store_boundary.py \
  skills/run-autopilot/cli/test_store_lane.py \
  skills/run-autopilot/cli/test_loop_record_store.py \
  skills/run-autopilot/scripts/test_store_tree_prose.py

# serial: pinned by test_enter_prose.py's exact invocation text; runs in
# ~2s serial, not worth the pin edit (PRD 00233)
echo "[checks] enter"
uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_enter.py \
  skills/run-autopilot/cli/test_enter_prose.py \
  skills/run-autopilot/cli/test_enter_guards.py \
  skills/run-autopilot/cli/test_enter_decisions.py \
  skills/run-autopilot/cli/test_enter_cli.py

echo "[checks] gather-context paths"
bash skills/review-work-completion/scripts/test_gather_context_paths.sh
