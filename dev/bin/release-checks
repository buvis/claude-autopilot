  skills/run-autopilot/cli/test_store_lane.py \
  skills/run-autopilot/cli/test_loop_record_store.py \
  skills/run-autopilot/scripts/test_store_tree_prose.py

# serial: pinned by test_enter_prose.py's exact invocation text; runs in
# ~2s serial, not worth the pin edit (PRD 00233)
echo "[checks] enter"
run_pytest uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_enter.py \
  skills/run-autopilot/cli/test_enter_prose.py \
  skills/run-autopilot/cli/test_enter_guards.py \
  skills/run-autopilot/cli/test_enter_decisions.py \
  skills/run-autopilot/cli/test_enter_cli.py

echo "[checks] gather-context paths"
run_gather_harness bash skills/review-work-completion/scripts/test_gather_context_paths.sh

echo "[checks] gather-context id"
run_gather_harness bash skills/review-work-completion/scripts/test_gather_context_id.sh

echo "[checks] review verbs"
run_pytest uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_verification.py \
  skills/run-autopilot/cli/test_review_stage.py \
  skills/run-autopilot/cli/test_review_close.py \
  skills/run-autopilot/cli/test_cli_review_verbs.py \
  skills/run-autopilot/cli/test_release_checks_counts.py

EXIT_CODE=0
if [[ "$TOTAL_FAIL" -ne 0 || "$INFRA_FAIL" -ne 0 ]]; then
  EXIT_CODE=1
fi
echo "PASS $TOTAL_PASS FAIL $TOTAL_FAIL SKIP $TOTAL_SKIP EXIT $EXIT_CODE"
exit "$EXIT_CODE"
