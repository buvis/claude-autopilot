  skills/run-autopilot/cli/test_wave_assemble.py \
  skills/run-autopilot/cli/test_wave_assemble_migrate.py \
  skills/run-autopilot/cli/test_wave_assemble_summary.py \
  skills/run-autopilot/cli/test_wave_cli_assemble.py \
  skills/run-autopilot/cli/test_wave_cli_refusals.py \
  skills/run-autopilot/cli/test_wave_docs.py \
  skills/run-autopilot/cli/test_wave_run.py \
  skills/run-autopilot/cli/test_wave_review.py \
  skills/run-autopilot/cli/test_wave_review_cleanup.py \
  skills/run-autopilot/cli/test_wave_review_land.py \
  skills/run-autopilot/cli/test_wave_slots.py \
  skills/run-autopilot/cli/test_wave_slots_release.py \
  skills/run-autopilot/cli/test_loop_slots.py

echo "[checks] store tree"
run_pytest uv run --no-project --with pytest python -m pytest -q \
  skills/run-autopilot/cli/test_store_tree_foreign_dirty.py \
  skills/run-autopilot/cli/test_store_tree_record_store.py \
